---
interface MenuItem {
  name: string;
  href: string;
}

interface Props {
  repositories: MenuItem[];
  organizations: MenuItem[];
}

const { repositories, organizations } = Astro.props;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href="/" aria-label="ORESoftware home">
      <span class="wordmark__glyph" aria-hidden="true">O</span>
      <span>ORESoftware</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <a href="/#organizations">Core projects</a>
      <a href="/22-factor-app/">22-factor app</a>

      <details class="nav-menu">
        <summary>Popular repos</summary>
        <div class="nav-menu__panel">
          {repositories.map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer">{item.name}<span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </details>

      <details class="nav-menu nav-menu--wide">
        <summary>Organizations</summary>
        <div class="nav-menu__panel nav-menu__panel--grid">
          {organizations.slice(0, 10).map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer">{item.name}<span aria-hidden="true">↗</span></a>
          ))}
          <a class="nav-menu__all" href="/#organizations">View all core projects <span aria-hidden="true">↓</span></a>
        </div>
      </details>

      <a href="https://github.com/ORESoftware" target="_blank" rel="noreferrer">GitHub</a>
    </nav>

    <details class="mobile-nav">
      <summary>Menu <span aria-hidden="true">☰</span></summary>
      <nav class="mobile-nav__panel" aria-label="Mobile navigation">
        <a href="/22-factor-app/">The 22-factor app</a>
        <a href="/#featured">Popular repositories</a>
        <a href="/#organizations">Core projects</a>
        <a href="https://github.com/ORESoftware" target="_blank" rel="noreferrer">ORESoftware on GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://the1mills.github.io" target="_blank" rel="noreferrer">Alex Mills <span aria-hidden="true">↗</span></a>
      </nav>
    </details>

    <a class="header-cta" href="https://the1mills.github.io" target="_blank" rel="noreferrer">
      Alex Mills <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
