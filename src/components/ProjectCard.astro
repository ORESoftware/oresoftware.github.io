---
interface Props {
  name: string;
  href: string;
  kind: string;
  description: string;
  tags: string[];
  searchable?: boolean;
}

const { name, href, kind, description, tags, searchable = false } = Astro.props;
const initials = name
  .split('-')
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');
const searchText = [name, kind, description, ...tags].join(' ').toLowerCase();
---

<a
  class="project-card"
  href={href}
  target="_blank"
  rel="noreferrer"
  data-project-card={searchable ? 'organization' : undefined}
  data-search={searchable ? searchText : undefined}
>
  <div class="project-card__topline">
    <span class="project-card__mark" aria-hidden="true">{initials}</span>
    <span class="project-card__kind">{kind}</span>
    <span class="project-card__arrow" aria-hidden="true">↗</span>
  </div>
  <h3>{name}</h3>
  <p>{description}</p>
  <ul class="tag-list" aria-label={`${name} topics`}>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</a>
