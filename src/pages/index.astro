---
import ProjectCard from '../components/ProjectCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects.json';

const { featuredRepositories, organizations } = projects;
const title = 'ORESoftware — Open-source systems and developer tools';
const description = 'Explore ORESoftware repositories and organizations spanning distributed systems, developer tooling, synchronization, media, infrastructure, and more.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader repositories={featuredRepositories} organizations={organizations} />

  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero__copy">
        <p class="eyebrow">Open-source engineering</p>
        <h1 id="hero-heading">Software for systems that matter.</h1>
        <p class="hero__lede">
          A connected portfolio of developer tools, distributed systems, secure applications,
          simulations, and product platforms—built in public and designed to work together.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="#organizations">Explore core projects <span aria-hidden="true">↓</span></a>
          <a class="button button--secondary" href="https://the1mills.github.io" target="_blank" rel="noreferrer">
            Meet the mastermind <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-logo-shell">
        <img
          class="hero-logo"
          src="/img/img.png"
          width="1928"
          height="262"
          alt="ORESoftware"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <section id="projects" class="projects-section shell" aria-labelledby="featured-heading">
      <div id="featured" class="section-heading">
        <div>
          <p class="eyebrow">Popular repositories</p>
          <h2 id="featured-heading">Established tools.</h2>
        </div>
        <p>Focused open-source projects for concurrency, testing, configuration, and release confidence.</p>
      </div>

      <div class="project-grid">
        {featuredRepositories.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section id="organizations" class="projects-section projects-section--orgs shell" aria-labelledby="organizations-heading">
      <div class="section-heading section-heading--filterable">
        <div>
          <p class="eyebrow">Core projects</p>
          <h2 id="organizations-heading">A connected portfolio of systems and products.</h2>
        </div>
        <div class="project-filter">
          <label for="project-filter">Filter core projects</label>
          <div class="project-filter__control">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg>
            <input id="project-filter" type="search" placeholder="Search names, technologies, or purpose…" autocomplete="off" />
          </div>
        </div>
      </div>

      <div class="project-grid" id="organization-grid">
        {organizations.map((project) => <ProjectCard {...project} searchable />)}
      </div>
      <p class="no-results" id="no-results" hidden>No matching projects. Try another name, technology, or area.</p>
    </section>

    <section class="maker shell" aria-labelledby="maker-heading">
      <div>
        <p class="eyebrow">Behind ORESoftware</p>
        <h2 id="maker-heading">Meet the mastermind connecting the ecosystem.</h2>
        <p>Projects, experiments, technical writing, and the person behind ORESoftware.</p>
      </div>
      <a class="button button--primary" href="https://the1mills.github.io" target="_blank" rel="noreferrer">
        Visit the1mills.github.io <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <SiteFooter />

  <script>
    const filter = document.querySelector<HTMLInputElement>('#project-filter');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card="organization"]'));
    const noResults = document.querySelector<HTMLElement>('#no-results');

    const updateFilter = () => {
      const query = filter?.value.trim().toLowerCase() ?? '';
      let hasMatches = false;

      for (const card of cards) {
        const matches = !query || (card.dataset.search ?? '').includes(query);
        card.hidden = !matches;
        hasMatches ||= matches;
      }

      if (noResults) noResults.hidden = hasMatches;
    };

    filter?.addEventListener('input', updateFilter);
  </script>
</BaseLayout>
